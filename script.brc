log "Enter target domain:";
set target = input "> ";

// --------------------
// DNS resolve
// --------------------
set ip = resolve target;
log "IP:";
log ip;

// --------------------
// Fetch homepage
// --------------------
set url = "http://" + target;

log "Fetching homepage...";

set response = transmit url "GET";

// save raw html
write "page.html" response;

// --------------------
// basic fingerprint
// --------------------
log "Fingerprinting...";

if response != "":
    log "Page size:";
    log num response;

    // crude tech detection
    if response == response:
        // just checking existence
        if response:
            log "Page fetched successfully";
        end
    end
end

// --------------------
// crude link extraction
// --------------------
log "Scanning for links...";

set i = 0;
set links = list;

// naive scan for "http"
while i < 2000:
    // (your language lacks substring funcs,
    // so we fake basic detection using patterns)

    // this part is symbolic — real parsing
    // would need string slicing support

    set i = i + 1;
end

// --------------------
// basic health check
// --------------------
log "Checking common endpoints...";

set paths = list;
push paths "/login";
push paths "/admin";
push paths "/api";
push paths "/dashboard";

for p in paths:
    set full = url + p;
    log "Checking:";
    log full;

    transmit full "GET";
end

// --------------------
// Save summary
// --------------------
append "report.txt" "Target: ";
append "report.txt" target;
append "report.txt" "\nIP: ";
append "report.txt" ip;

log "Report saved.";