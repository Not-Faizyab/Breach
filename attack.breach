set target = 1.1.1.1;
set port = 80;

log "--- BREACH PROTOCOL INITIATED ---";
log "Scanning target:";
log target;

scan target:
    if open:
        log "[!] PORT 80 CONFIRMED OPEN. Executing payload...";
        payload target port "GET / HTTP/1.1\r\nHost: 1.1.1.1\r\n\r\n";
    end
end

log "--- PROTOCOL COMPLETE ---";