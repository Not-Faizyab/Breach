log "--- SOVEREIGN OS: TERMINAL CALCULATOR ---";
log "Type '0' as the first number to exit.";

while 1 == 1:
    log " ";
    set a_raw = input "Enter first number: ";
    set a = num a_raw; 

    if a == 0:
        log "[*] Shutting down calculator...";
        break; 
    end

    // THE FIX: Renamed the variable from 'op' to 'operator'
    set operator = input "Enter operator (+, -, *, /, %): ";
    set b_raw = input "Enter second number: ";
    set b = num b_raw;

    set result = 0;

    if operator == "+": set result = a + b; end
    if operator == "-": set result = a - b; end
    if operator == "*": set result = a * b; end
    if operator == "%": set result = a % b; end
    
    if operator == "/": 
        try:
            set result = a / b;
        rescue:
            log "[!] Error: Math violation (Division by zero)";
        end
    end

    log "Result: ";
    log result;
end