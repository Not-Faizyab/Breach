op scan_and_log:
    log "Initiating localized scan on: " + target;
    swarm target ports 1 to 100:
        if open:
            log "[!] Verified Target Port: " + port;
        end
    end
end

set hostname = input "Enter Domain to Resolve: ";
set target = resolve hostname;
log "Resolved IP: " + target;

call scan_and_log;