set targets = list;
push targets "1.1.1.1";
push targets "8.8.8.8";

log "--- INITIATING STEALTH SWARM ---";

for target in targets:
    set delay = rand 100 to 1000;
    log "Jitter delay active (ms):";
    log delay;
    wait delay;

    swarm target ports 1 to 100:
        if open:
            append "found.log" target;
            append "found.log" port;
            log "[!] SUCCESS SAVED TO LOG";
        end
    end
end

log "--- SEQUENCE FINALIZED ---";